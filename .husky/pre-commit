# ultracite
#!/bin/sh
# Check if there are any staged files
STAGED_FILES=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

# Run formatter on the staged files only (unstaged files are left untouched),
# capturing the exit code so we can still re-stage and report. Split the list
# on newlines only, with globbing off, so paths with spaces or `*` survive.
# Git still C-quotes names containing `"`, `\`, tab or newline; such files are
# skipped (Biome reports "No such file" but exits 0) and committed unformatted.
FORMAT_EXIT_CODE=0
set -f
OLD_IFS=$IFS
IFS='
'
set -- $STAGED_FILES
IFS=$OLD_IFS
set +f
bun x ultracite fix "$@" || FORMAT_EXIT_CODE=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Ultracite found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Ultracite"
# ultracite end
